{
    "manifest_version": 3,
    "version": "1.0",
    "name": "Leads Tracker",
    "description": "Save and manage leads directly from your Chrome browser.",
    "action": {
        "default_popup": "index.html",
        "default_icon": "images/icon.png"
    },
    "permissions": [
        "tabs"
    ]
}